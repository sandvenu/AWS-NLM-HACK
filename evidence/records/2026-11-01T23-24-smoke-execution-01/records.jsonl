{"run_id": "2026-11-01T23-24-smoke-execution-01", "unit": "execution", "item_id": "exe-0010", "model_id": "otel-llm-1.7b-it@2a2d417b", "adapter_id": "none", "grader": "rule-based-parser-v1", "test_set_sha256": "e0152332fba3d220e0e23af6068f127ef4c8cf12333d93efa9a3263c40007a63", "prompt_sha256": "47125a12186ebf0d8dbea3046ded0ff5af3fee1b595d6971ec66d8a5d0c38a86", "output": "The usable bandwidth is 5 MHz - 7.2% of 5 MHz = 5 MHz - 0.36 MHz = 4.64 MHz. The subcarrier spacing is 15 kHz, and there are 12 subcarriers per resource block. The number of whole resource blocks in the usable bandwidth is 4640000 / 15000 = 310.666, so 310 whole resource blocks fit in the usable bandwidth.", "output_sha256": "f50e3e28a016ea5c47b2df0db2478158379c3ddab6d70b97b0137a3a331d7c71", "output_tokens": 110, "truncated": false, "batch_started_at": "2026-11-01T23:28:56.213+00:00", "batch_finished_at": "2026-11-01T23:29:03.584+00:00", "batch_wall_s": 7.3709, "latency_s": 0.4607, "parsed": null, "gold": 25.0, "correct": false, "correct_loose": false}
{"run_id": "2026-11-01T23-24-smoke-execution-01", "unit": "execution", "item_id": "exe-0011", "model_id": "otel-llm-1.7b-it@2a2d417b", "adapter_id": "none", "grader": "rule-based-parser-v1", "test_set_sha256": "e0152332fba3d220e0e23af6068f127ef4c8cf12333d93efa9a3263c40007a63", "prompt_sha256": "2561404474945c700487eb185189536030977fc44789b8b90a9fe2b52e32bf32", "output": "Rate = 1 * 2 * 0.65 * 133 * 12 / 1e-3 / (14 * 15/15) * (1 - 0.14) = 1 * 2 * 0.65 * 133 * 12 / 1e-3 * 0.86 = 2511.84 Mbit/s.", "output_sha256": "acc52a3adcfbdaf82d5183a080860b5239d342ecb2dea15c3b85d154ca083a1e", "output_tokens": 97, "truncated": false, "batch_started_at": "2026-11-01T23:28:56.213+00:00", "batch_finished_at": "2026-11-01T23:29:03.584+00:00", "batch_wall_s": 7.3709, "latency_s": 0.4607, "parsed": null, "gold": 24.9806, "correct": false, "correct_loose": false}
{"run_id": "2026-11-01T23-24-smoke-execution-01", "unit": "execution", "item_id": "exe-0012", "model_id": "otel-llm-1.7b-it@2a2d417b", "adapter_id": "none", "grader": "rule-based-parser-v1", "test_set_sha256": "e0152332fba3d220e0e23af6068f127ef4c8cf12333d93efa9a3263c40007a63", "prompt_sha256": "2b1b758adb69695c504650e9a69ca3af33b592e09df357a1373d3119e671c018", "output": "Spectral efficiency = 66.7 Mbit/s / 20 MHz = 3.335 bit/s/Hz\n\nFinal answer: 3.335", "output_sha256": "8b9beac1cd9cac21a1e52cecbafe8aefe50859e9d759b1524f21086030fd923d", "output_tokens": 39, "truncated": false, "batch_started_at": "2026-11-01T23:28:56.213+00:00", "batch_finished_at": "2026-11-01T23:29:03.584+00:00", "batch_wall_s": 7.3709, "latency_s": 0.4607, "parsed": 3.335, "gold": 3.335, "correct": true, "correct_loose": true}
